// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum BatchStatus {
  DRAFT
  OPEN
  CLOSED
  FULL
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  WAITLISTED
}

enum SeatStatus {
  RESERVED
  RELEASED
}

enum PaymentStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  SADAPAY
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs        AuditLog[]
  reviewedPayments Payment[] @relation("PaymentReviewer")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  duration    String
  fee         Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches Batch[]
}

model Batch {
  id            String      @id @default(cuid())
  courseId      String
  identifier    String      @unique
  month         Int
  year          Int
  startDate     DateTime?
  endDate       DateTime?
  daysOfWeek    String
  startTime     String
  endTime       String
  capacity      Int         @default(15)
  reservedSeats Int         @default(0)
  status        BatchStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([courseId, year, month])
  @@index([status, startDate])
}

model Student {
  id           String   @id @default(cuid())
  fullName     String
  fatherName   String
  phone        String
  whatsapp     String
  email        String
  cnic         String?
  education    String
  occupation   String?
  experience   String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]

  @@index([email])
  @@index([phone])
}

model Application {
  id            String            @id @default(cuid())
  studentId     String
  batchId       String
  status        ApplicationStatus @default(PENDING)
  seatStatus    SeatStatus        @default(RESERVED)
  appliedAt     DateTime          @default(now())
  confirmedAt   DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  payment Payment?

  @@unique([studentId, batchId])
  @@index([batchId, seatStatus])
  @@index([status, appliedAt])
}

model Payment {
  id                            String        @id @default(cuid())
  applicationId                 String        @unique
  status                        PaymentStatus @default(NOT_SUBMITTED)
  method                        PaymentMethod?
  expectedAmount                Decimal?      @db.Decimal(10, 2)
  amount                        Decimal?      @db.Decimal(10, 2)
  transactionReference          String?
  normalizedTransactionReference String?
  paymentDate                   DateTime?
  receiptPath                   String?
  submittedAt                   DateTime?
  reviewedAt                    DateTime?
  verifiedAt                    DateTime?
  reviewedById                  String?
  rejectionReason               String?
  studentTokenHash              String?       @unique
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([method, normalizedTransactionReference])
  @@index([status, submittedAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([createdAt])
}
